{
  "name": "jonghoon-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "export": "python3 ../hooni/scripts/vault_db.py export --vault blog-vault --output ./generated",
    "dev": "npm run export && astro dev --host 0.0.0.0",
    "dev:full": "npm run build && npm run likes:migrate:local && wrangler dev --env local --port 8787",
    "check": "npm run export && astro check",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run export && npm run test && astro check && astro build && npm run privacy-check",
    "privacy-check": "node scripts/privacy-check.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "likes:migrate:local": "wrangler d1 migrations apply DB --local --env local",
    "likes:migrate:remote": "wrangler d1 migrations apply DB --remote --env=\"\"",
    "deploy": "npm run build && wrangler deploy --env=\"\""
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.3",
    "d3": "^7.9.0",
    "katex": "^0.18.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^6.0.3",
    "wrangler": "^4.114.0"
  }
}
