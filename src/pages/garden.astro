---
const target = "/graph/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={new URL(target, Astro.site)} />
    <title>Knowledge Graph · Jong Hoon</title>
  </head>
  <body>
    <p>The graph moved to <a href={target}>{target}</a>.</p>
  </body>
</html>
