---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found">
  <section class="not-found">
    <p class="eyebrow">404</p>
    <h1>This path has not grown into a note.</h1>
    <p>Return to the writing index or explore nearby ideas in the garden.</p>
    <div class="hero-actions">
      <a class="button primary" href="/">Browse writing</a>
      <a class="button quiet" href="/graph/">Open graph</a>
    </div>
  </section>
</BaseLayout>
